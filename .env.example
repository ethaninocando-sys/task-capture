# Copy this file to .env.local and fill in both values.
# Find them in Supabase → Project Settings → API Keys (and Data API for the URL).
# The publishable key is safe to use in a browser app. NEVER put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
